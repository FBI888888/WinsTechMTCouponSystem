# =====================================================
# WinsTechMT Coupon System 后端配置模板
# 复制此文件为 .env 并填写实际值
# =====================================================

# 应用配置
APP_NAME=MT Coupon System
DEBUG=true

# 数据库配置
# 开发环境: localhost
# 生产环境: winssql.winstech.top
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mt_coupon
DB_USER=root
DB_PASSWORD=your_db_password_here

# JWT 配置（生产环境必须修改！）
SECRET_KEY=your_secret_key_here_please_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS 配置（多个域名用逗号分隔）
# 开发环境: ["http://localhost:5173", "http://localhost:3000"]
# 生产环境: ["http://winscoupons.winstech.top"]
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Node.js 路径（用于签名脚本）
# 开发环境: node
# 生产环境: /www/server/nodejs/v20.10.0/bin/node
NODE_PATH=node

# 扫描配置
SCAN_INTERVAL_MINUTES=30
SCAN_REQUEST_INTERVAL=0.7
SCAN_MAX_RETRIES=3

# 代理配置
PROXY_PORT=8888

# 速率限制配置
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_LOGIN_PER_MINUTE=5

# Token 加密配置
TOKEN_ENCRYPTION_ENABLED=false
ENCRYPTION_KEY=your_encryption_key_here_32_chars

# Native 实例账号（统一调度中心 OpenAPI）
# 以下三项仅作为尚未在“系统设置”页面保存配置时的启动回退值。
# 前端管理员保存后以数据库中的加密配置为准；生产环境仍必须配置稳定 ENCRYPTION_KEY。
NATIVE_ACCOUNT_ENABLED=false
WXCODE_SERVICE_URL=https://wxcode.example.com
WXCODE_SERVICE_API_KEY=replace_with_business_client_api_key
NATIVE_CREDENTIAL_MAX_AGE_HOURS=12
NATIVE_REFRESH_DEADLINE_SECONDS=420
